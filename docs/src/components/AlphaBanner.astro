---
/**
 * Site-wide alpha notice (Starlight `Banner` override). Skipped on the
 * full-screen demo, where every pixel of height goes to the app.
 */
const { id } = Astro.locals.starlightRoute;
const hidden = id === 'demo';
---

{
  !hidden && (
    <div class="tsg-alpha-banner" data-pagefind-ignore>
      <span class="tsg-alpha-banner__tag">Alpha</span>
      <span>
        TS-Git handles the everyday workflow, including clone, fetch, push, pull and merge, but
        some Git features are still missing and APIs may change.{' '}
        <a href="/roadmap/">See the roadmap</a>
      </span>
    </div>
  )
}

<style>
  @layer starlight.core {
    .tsg-alpha-banner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.25rem 0.625rem;
      padding: 0.625rem 1rem;
      border-block-end: 1px solid var(--border);
      background: var(--background);
      color: var(--muted-foreground);
      font-size: 0.8125rem;
      line-height: 1.45;
      text-align: center;
      text-wrap: balance;
    }

    .tsg-alpha-banner__tag {
      flex-shrink: 0;
      padding: 0.0625rem 0.5rem;
      border: 1px solid color-mix(in srgb, var(--tsg-brand) 55%, transparent);
      border-radius: 999px;
      color: var(--tsg-brand-strong);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .tsg-alpha-banner a {
      color: var(--foreground);
      font-weight: 500;
      text-decoration: underline;
      text-decoration-color: var(--muted-foreground);
      text-underline-offset: 0.2em;
    }

    .tsg-alpha-banner a:hover {
      text-decoration-color: var(--foreground);
    }
  }
</style>
