---
/**
 * Mounts the @ts-git/ui demo app (file sidebar + terminal) against an
 * in-memory filesystem. The app fills its parent, so size the parent.
 *
 * The UI package ships a dark, self-contained palette; the overrides below
 * remap its CSS variables onto the docs theme tokens so the demo follows the
 * site's black/white look and its light/dark switch.
 */
---

<div class="tsg-demo" aria-label="TS-Git interactive demo">
  <!-- @ts-git/ui replaces this element's class with `app`. -->
  <div class="tsg-demo__mount" data-tsg-demo></div>
</div>

<script>
  import { createMemoryFS, GitClient } from '@keydown-dev/ts-git';
  import { App } from '@ts-git/ui';

  import '@ts-git/ui/styles.css';

  const WORKING_DIR = '/Workspace';
  const GIT_DIR = '/Workspace/.git';

  async function mount(container: HTMLElement) {
    const fs = createMemoryFS();
    await fs.mkdir(WORKING_DIR, { recursive: true });

    await fs.writeFile(
      `${WORKING_DIR}/README.md`,
      '# TS-Git Demo\n\nThis repository lives in an in-memory filesystem in your browser.\nTry `git init`, `git add README.md` and `git commit -m "First commit"` in the terminal.\n'
    );

    const git = new GitClient({
      fs,
      dir: WORKING_DIR,
      gitdir: GIT_DIR,
      defaultBranch: 'main',
    });

    new App({
      container,
      fs,
      git,
      author: { name: 'Demo User', email: 'demo@example.com' },
      currentDir: WORKING_DIR,
      gitdir: GIT_DIR,
      welcomeMessage: `TS-Git interactive demo, running entirely in your browser.\nCurrent directory: ${WORKING_DIR}\nType "help" for available commands, or start with "git init".`,
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tsg-demo]').forEach((el) => {
    mount(el).catch(console.error);
  });
</script>

<style is:global>
  .tsg-demo,
  .tsg-demo > [data-tsg-demo] {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  /* Remap @ts-git/ui's palette onto the docs theme (higher specificity than `.app`). */
  .tsg-demo .app {
    --bg-primary: var(--background);
    --bg-secondary: color-mix(in oklab, var(--background) 96%, var(--foreground));
    --bg-tertiary: var(--gray-7);
    --border-color: var(--border);
    --border-subtle: color-mix(in oklab, var(--border) 60%, transparent);
    --hover-color: color-mix(in oklab, var(--foreground) 6%, transparent);
    --text-primary: var(--gray-2);
    --text-secondary: var(--muted-foreground);
    --text-muted: var(--gray-4);
    --text-strong: var(--foreground);
    --text-on-accent: #fff;
    --accent-blue: var(--tsg-brand-strong);
    --status-staged: var(--tsg-brand-strong);
    --font-family: var(--__sl-font);
    --font-mono: var(--__sl-font-mono);
    --terminal-font-size: 0.8125rem;
    --terminal-line-height: 1.75rem;
  }

  :root[data-theme='light'] .tsg-demo .app {
    --accent-green: #1a7f37;
    --accent-red: #cf222e;
    --accent-yellow: #9a6700;
    --accent-purple: #8250df;
    --accent-orange: #bc4c00;
    --status-added: #1a7f37;
    --status-deleted: #cf222e;
    --status-modified: #9a6700;
    --status-untracked: #6e7781;
  }

  .tsg-demo .app ::selection {
    background-color: color-mix(in srgb, var(--tsg-brand) 35%, transparent);
  }

  .tsg-demo .app__overlay {
    background-color: color-mix(in srgb, var(--background) 88%, transparent);
  }

  .tsg-demo .app__overlay-body .button--primary {
    background-color: var(--foreground);
    color: var(--background);
  }

  .tsg-demo .app__overlay-body .button--primary:hover {
    background-color: var(--gray-2);
  }

  .tsg-demo .terminal__line .diff-snippet__header {
    color: var(--tsg-brand-strong);
  }

  .tsg-demo .terminal__line .diff-snippet__removed {
    color: var(--tsg-diff-del);
  }

  .tsg-demo .terminal__line .diff-snippet__added {
    color: var(--tsg-diff-add);
  }

  /* Phones: stack the file sidebar above the terminal instead of side by side. */
  @media (max-width: 40rem) {
    .tsg-demo .app__main {
      flex-direction: column;
    }

    .tsg-demo .app__sidebar-dock {
      flex: 0 0 40%;
      min-height: 0;
    }

    .tsg-demo .sidebar {
      width: 100% !important;
      border-right: 0;
      border-bottom: 1px solid var(--border-color);
    }

    .tsg-demo .sidebar__resize-handle {
      display: none;
    }

    .tsg-demo .panel {
      min-width: 0;
      min-height: 0;
    }
  }
</style>
