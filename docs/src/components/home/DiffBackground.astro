---
/**
 * Decorative hero backdrop: a deep navy field with a soft brand-blue glow
 * (PR #10's original hero colours) and one layer of git-diff text that
 * drifts slowly as the page scrolls. It fills its positioned parent (the
 * hero band, which also sits behind the transparent header) and fades into
 * the plain page background at the bottom edge. Purely presentational: hidden
 * from assistive tech, no pointer events, and static under
 * prefers-reduced-motion.
 */
import { hunks, hunkHeader } from './diff-hunks';

type Line = { kind: 'h' | 'a' | 'd' | 'c'; text: string };

/** Build one column: a run of hunks, repeated twice so scrolling can wrap seamlessly. */
function buildColumn(seed: number, count: number): Line[] {
  const run: Line[] = [];
  for (let i = 0; i < count; i++) {
    const hunk = hunks[(seed + i * 3) % hunks.length];
    const start = 12 + ((seed * 47 + i * 89) % 260);
    run.push({ kind: 'h', text: hunkHeader(hunk, start) });
    for (const line of hunk.lines) {
      const kind = line[0] === '+' ? 'a' : line[0] === '-' ? 'd' : 'c';
      run.push({ kind, text: line });
    }
    run.push({ kind: 'c', text: ' ' });
  }
  return [...run, ...run];
}

const columns = [0, 1, 2].map((c) => buildColumn(c * 3 + 1, 6));
---

<div class="tsg-bg" aria-hidden="true">
  <div class="tsg-bg__glow"></div>
  <div class="tsg-bg__layer" data-speed="0.18">
    {
      columns.map((lines, i) => (
        <div class={`tsg-col tsg-col--${i}`}>
          {lines.map((l) => (
            <div class={`l ${l.kind}`}>{l.text}</div>
          ))}
        </div>
      ))
    }
  </div>
  <div class="tsg-bg__veil"></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.tsg-bg');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root) {
    const speed = Number(root.querySelector<HTMLElement>('.tsg-bg__layer')?.dataset.speed) || 0;
    let cols: { el: HTMLElement; half: number }[] = [];
    let ticking = false;
    let visible = true;

    const measure = () => {
      cols = [];
      root.querySelectorAll<HTMLElement>('.tsg-col').forEach((el) => {
        // offsetParent is null for display:none columns (hidden on small screens).
        if (el.offsetParent === null) return;
        cols.push({ el, half: el.offsetHeight / 2 });
      });
    };

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      for (const c of cols) {
        // Content is duplicated, so wrapping at half the height is seamless.
        const offset = c.half > 0 ? (y * speed) % c.half : 0;
        c.el.style.transform = `translate3d(0, ${-offset.toFixed(1)}px, 0)`;
      }
    };

    const onScroll = () => {
      if (visible && !ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    let resizeTimer: number | undefined;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        update();
      }, 150);
    };

    // Only animate while the hero is on screen.
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    });

    const enable = () => {
      measure();
      update();
      io.observe(root);
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
    };

    const disable = () => {
      io.disconnect();
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      root.querySelectorAll<HTMLElement>('.tsg-col').forEach((el) => (el.style.transform = ''));
    };

    if (!reduceMotion.matches) enable();
    reduceMotion.addEventListener('change', (e) => (e.matches ? disable() : enable()));
  }
</script>

<style>
  .tsg-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    contain: strict;
    background: var(--tsg-hero-bg);
    --tsg-hero-bg: #0a1426;
  }

  :global([data-theme='light']) .tsg-bg {
    --tsg-hero-bg: hsl(213, 45%, 97%);
  }

  .tsg-bg__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60rem 40rem at 85% -10%, hsla(211, 60%, 48%, 0.28), transparent 60%),
      radial-gradient(50rem 36rem at -10% 90%, hsla(211, 70%, 40%, 0.16), transparent 60%);
  }

  :global([data-theme='light']) .tsg-bg__glow {
    background:
      radial-gradient(60rem 40rem at 85% -10%, hsla(211, 60%, 48%, 0.16), transparent 60%),
      radial-gradient(50rem 36rem at -10% 90%, hsla(211, 70%, 55%, 0.1), transparent 60%);
  }

  .tsg-bg__layer {
    position: absolute;
    inset: 0;
    font-family: var(--__sl-font-mono);
    font-size: 13px;
    line-height: 1.65;
    white-space: pre;
    opacity: 0.32;
  }

  .tsg-col {
    position: absolute;
    top: -6rem;
    width: 36rem;
    overflow-x: clip;
    will-change: transform;
  }
  .tsg-col--0 { left: -4%; }
  .tsg-col--1 { left: 31%; top: -16rem; }
  .tsg-col--2 { left: 66%; top: -2rem; }

  .l {
    padding-inline: 0.75em;
    border-inline-start: 2px solid transparent;
  }

  .h {
    color: #79b8ff;
    opacity: 0.85;
  }
  :global([data-theme='light']) .h {
    color: #0b5cad;
  }
  .a {
    color: var(--tsg-diff-add);
    background: color-mix(in srgb, var(--tsg-diff-add) 10%, transparent);
    border-inline-start-color: color-mix(in srgb, var(--tsg-diff-add) 50%, transparent);
  }
  .d {
    color: var(--tsg-diff-del);
    background: color-mix(in srgb, var(--tsg-diff-del) 10%, transparent);
    border-inline-start-color: color-mix(in srgb, var(--tsg-diff-del) 50%, transparent);
  }
  .c {
    color: hsl(213, 25%, 70%);
    opacity: 0.6;
  }
  :global([data-theme='light']) .c {
    color: hsl(216, 20%, 40%);
  }

  :global([data-theme='light']) .tsg-bg__layer {
    opacity: 0.22;
  }

  /*
   * Readability veil: navy behind the hero copy, then a long fade into the
   * plain page background so the band ends on the site's black (or white).
   */
  .tsg-bg__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(48rem 30rem at 28% 50%, color-mix(in srgb, var(--tsg-hero-bg) 88%, transparent), transparent 70%),
      /* Calm the diff text behind the transparent header. */
      linear-gradient(180deg, color-mix(in srgb, var(--tsg-hero-bg) 70%, transparent) 0, transparent 7rem),
      linear-gradient(180deg, transparent 0%, transparent 60%, var(--background) 100%);
  }

  @media (max-width: 50rem) {
    .tsg-col--2 {
      display: none;
    }
    .tsg-col--0 { left: -30%; }
    .tsg-col--1 { left: 45%; }
    .tsg-bg__veil {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--tsg-hero-bg) 82%, transparent),
        color-mix(in srgb, var(--tsg-hero-bg) 72%, transparent) 60%,
        var(--background) 100%
      );
    }
  }
</style>
