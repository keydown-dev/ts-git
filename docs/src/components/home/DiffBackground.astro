---
/**
 * Decorative homepage backdrop: three layers of git-diff text drifting at
 * different speeds on scroll (parallax). Purely presentational: hidden from
 * assistive tech, no pointer events, and static under prefers-reduced-motion.
 */
import { hunks, hunkHeader } from './diff-hunks';

interface Column {
  lines: { kind: 'h' | 'a' | 'd' | 'c'; text: string }[];
}

interface Layer {
  name: 'far' | 'mid' | 'near';
  speed: number;
  columns: Column[];
}

/** Build one column: a run of hunks, repeated twice so scrolling can wrap seamlessly. */
function buildColumn(seed: number, count: number): Column {
  const run: Column['lines'] = [];
  for (let i = 0; i < count; i++) {
    const hunk = hunks[(seed + i * 3) % hunks.length];
    const start = 12 + ((seed * 47 + i * 89) % 260);
    run.push({ kind: 'h', text: hunkHeader(hunk, start) });
    for (const line of hunk.lines) {
      const kind = line[0] === '+' ? 'a' : line[0] === '-' ? 'd' : 'c';
      run.push({ kind, text: line });
    }
    run.push({ kind: 'c', text: ' ' });
  }
  return { lines: [...run, ...run] };
}

const layers: Layer[] = [
  { name: 'far', speed: 0.08, columns: [0, 1, 2, 3].map((c) => buildColumn(c * 2 + 1, 7)) },
  { name: 'mid', speed: 0.2, columns: [0, 1, 2].map((c) => buildColumn(c * 3 + 4, 6)) },
  { name: 'near', speed: 0.38, columns: [0, 1].map((c) => buildColumn(c * 5 + 2, 5)) },
];
---

<div class="tsg-bg" aria-hidden="true">
  <div class="tsg-bg__glow"></div>
  {
    layers.map((layer) => (
      <div class={`tsg-layer tsg-layer--${layer.name}`} data-speed={layer.speed}>
        {layer.columns.map((col, i) => (
          <div class={`tsg-col tsg-col--${i}`}>
            {col.lines.map((l) => (
              <div class={`l ${l.kind}`}>{l.text}</div>
            ))}
          </div>
        ))}
      </div>
    ))
  }
  <div class="tsg-bg__veil"></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.tsg-bg');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root) {
    type Col = { el: HTMLElement; speed: number; half: number };
    let cols: Col[] = [];
    let ticking = false;

    const measure = () => {
      cols = [];
      root.querySelectorAll<HTMLElement>('.tsg-layer').forEach((layer) => {
        const speed = Number(layer.dataset.speed) || 0;
        layer.querySelectorAll<HTMLElement>('.tsg-col').forEach((el) => {
          // offsetParent is null for display:none columns (hidden on small screens).
          if (el.offsetParent === null) return;
          cols.push({ el, speed, half: el.offsetHeight / 2 });
        });
      });
    };

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      for (const c of cols) {
        // Content is duplicated, so wrapping at half the height is seamless.
        const offset = c.half > 0 ? (y * c.speed) % c.half : 0;
        c.el.style.transform = `translate3d(0, ${-offset.toFixed(1)}px, 0)`;
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const enable = () => {
      measure();
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
    };

    const disable = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      root.querySelectorAll<HTMLElement>('.tsg-col').forEach((el) => (el.style.transform = ''));
    };

    let resizeTimer: number | undefined;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        update();
      }, 150);
    };

    if (!reduceMotion.matches) enable();
    reduceMotion.addEventListener('change', (e) => (e.matches ? disable() : enable()));
  }
</script>

<style>
  .tsg-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    background: var(--tsg-bg-base);
    contain: strict;
    --tsg-bg-base: var(--tsg-navy-900);
  }

  :global([data-theme='light']) .tsg-bg {
    --tsg-bg-base: hsl(213, 45%, 97%);
  }

  .tsg-bg__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60rem 40rem at 85% -10%, hsla(211, 60%, 48%, 0.28), transparent 60%),
      radial-gradient(50rem 36rem at -10% 110%, hsla(211, 70%, 40%, 0.18), transparent 60%);
  }

  :global([data-theme='light']) .tsg-bg__glow {
    background:
      radial-gradient(60rem 40rem at 85% -10%, hsla(211, 60%, 48%, 0.16), transparent 60%),
      radial-gradient(50rem 36rem at -10% 110%, hsla(211, 70%, 55%, 0.1), transparent 60%);
  }

  .tsg-layer {
    position: absolute;
    inset: 0;
    font-family: var(--__sl-font-mono);
    white-space: pre;
  }

  .tsg-col {
    position: absolute;
    top: 0;
    overflow-x: clip;
    will-change: transform;
  }

  .l {
    padding-inline: 0.75em;
    border-inline-start: 2px solid transparent;
  }

  .h {
    color: var(--tsg-diff-hunk);
    opacity: 0.85;
  }
  .a {
    color: var(--tsg-diff-add);
    background: color-mix(in srgb, var(--tsg-diff-add) 12%, transparent);
    border-inline-start-color: color-mix(in srgb, var(--tsg-diff-add) 55%, transparent);
  }
  .d {
    color: var(--tsg-diff-del);
    background: color-mix(in srgb, var(--tsg-diff-del) 12%, transparent);
    border-inline-start-color: color-mix(in srgb, var(--tsg-diff-del) 55%, transparent);
  }
  .c {
    color: hsl(213, 25%, 70%);
    opacity: 0.6;
  }
  :global([data-theme='light']) .c {
    color: hsl(216, 20%, 40%);
  }

  /* Far layer: small, dim, dense. */
  .tsg-layer--far {
    font-size: 11px;
    line-height: 1.6;
    opacity: 0.16;
  }
  .tsg-layer--far .tsg-col {
    width: 34rem;
  }
  .tsg-layer--far .tsg-col--0 { left: -2%; top: -4rem; }
  .tsg-layer--far .tsg-col--1 { left: 24%; top: -18rem; }
  .tsg-layer--far .tsg-col--2 { left: 50%; top: -9rem; }
  .tsg-layer--far .tsg-col--3 { left: 76%; top: -26rem; }

  /* Mid layer */
  .tsg-layer--mid {
    font-size: 13px;
    line-height: 1.65;
    opacity: 0.24;
  }
  .tsg-layer--mid .tsg-col {
    width: 38rem;
  }
  .tsg-layer--mid .tsg-col--0 { left: 6%; top: 6rem; }
  .tsg-layer--mid .tsg-col--1 { left: 40%; top: -12rem; }
  .tsg-layer--mid .tsg-col--2 { left: 72%; top: 2rem; }

  /* Near layer: larger and sparse, kept to the edges. */
  .tsg-layer--near {
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.3;
  }
  .tsg-layer--near .tsg-col {
    width: 34rem;
  }
  .tsg-layer--near .tsg-col--0 { left: -18rem; top: 40rem; }
  .tsg-layer--near .tsg-col--1 { right: -12rem; top: -6rem; }

  :global([data-theme='light']) .tsg-layer--far { opacity: 0.15; }
  :global([data-theme='light']) .tsg-layer--mid { opacity: 0.2; }
  :global([data-theme='light']) .tsg-layer--near { opacity: 0.24; }

  /* Readability veil: darkest where the hero copy sits, lighter at the edges. */
  .tsg-bg__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(52rem 34rem at 26% 42%, hsla(219, 52%, 9%, 0.9), hsla(219, 52%, 9%, 0.55) 60%, hsla(219, 52%, 9%, 0.2)),
      linear-gradient(180deg, hsla(219, 52%, 9%, 0) 55%, hsla(219, 52%, 7%, 0.55));
  }
  :global([data-theme='light']) .tsg-bg__veil {
    background:
      radial-gradient(52rem 34rem at 26% 42%, hsla(213, 45%, 98%, 0.92), hsla(213, 45%, 98%, 0.6) 60%, hsla(213, 45%, 98%, 0.3)),
      linear-gradient(180deg, hsla(213, 45%, 98%, 0) 55%, hsla(213, 45%, 98%, 0.6));
  }

  @media (max-width: 50rem) {
    .tsg-layer--far .tsg-col--2,
    .tsg-layer--far .tsg-col--3,
    .tsg-layer--mid .tsg-col--2,
    .tsg-layer--near .tsg-col--1 {
      display: none;
    }
    .tsg-layer--far .tsg-col--1 { left: 48%; }
    .tsg-layer--mid .tsg-col--0 { left: -4%; }
    .tsg-layer--mid .tsg-col--1 { left: 46%; }
    .tsg-layer--near .tsg-col--0 { left: -6rem; top: 30rem; }
    .tsg-bg__veil {
      background: linear-gradient(180deg, hsla(219, 52%, 9%, 0.8), hsla(219, 52%, 9%, 0.66) 50%, hsla(219, 52%, 8%, 0.8));
    }
    :global([data-theme='light']) .tsg-bg__veil {
      background: linear-gradient(180deg, hsla(213, 45%, 98%, 0.78), hsla(213, 45%, 98%, 0.6) 50%, hsla(213, 45%, 98%, 0.78));
    }
  }
</style>
