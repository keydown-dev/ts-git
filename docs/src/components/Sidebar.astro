---
/**
 * Starlight `Sidebar` override: Lucode's sidebar plus a collapse toggle for
 * the desktop layout (≥ 1024px, where Lucode shows the sidebar in a sticky
 * grid column). Collapsing shrinks that column to a narrow rail that keeps
 * the toggle. The choice persists across pages in localStorage. The mobile
 * drawer renders its own navigation and is unaffected.
 */
import { Icon } from '@astrojs/starlight/components';
import LucodeSidebar from 'lucode-starlight/components/overrides/Sidebar.astro';
---

<script is:inline>
  // Apply the saved state before the content below the sidebar paints.
  try {
    if (localStorage.getItem('tsg-sidebar') === 'collapsed') {
      document.documentElement.dataset.tsgSidebar = 'collapsed';
    }
  } catch {}
</script>

<button
  type="button"
  class="tsg-sidebar-toggle"
  aria-expanded="true"
  aria-label="Collapse sidebar"
  title="Collapse sidebar"
  data-tsg-sidebar-toggle
>
  <Icon name="left-arrow" size="1rem" />
</button>

<!-- No `id` here: Lucode's TOC script walks every `main [id]` element and
     loops on ids outside the article. -->
<div class="tsg-sidebar">
  <LucodeSidebar />
</div>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-tsg-sidebar-toggle]');

  const sync = () => {
    const collapsed = root.dataset.tsgSidebar === 'collapsed';
    const label = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
    button?.setAttribute('aria-expanded', String(!collapsed));
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
  };

  button?.addEventListener('click', () => {
    const collapse = root.dataset.tsgSidebar !== 'collapsed';
    if (collapse) root.dataset.tsgSidebar = 'collapsed';
    else delete root.dataset.tsgSidebar;
    try {
      if (collapse) localStorage.setItem('tsg-sidebar', 'collapsed');
      else localStorage.removeItem('tsg-sidebar');
    } catch {}
    sync();
  });

  sync();
</script>

<style>
  .tsg-sidebar {
    height: 100%;
  }

  .tsg-sidebar-toggle {
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    z-index: 20;
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 4px);
    background: var(--background);
    color: var(--muted-foreground);
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .tsg-sidebar-toggle:hover {
    color: var(--foreground);
    background: var(--secondary);
  }

  .tsg-sidebar-toggle :global(svg) {
    transition: transform 0.2s ease;
  }

  @media (min-width: 1024px) {
    .tsg-sidebar-toggle {
      display: inline-flex;
    }

    :global(.aside) {
      /* Anchor for the absolutely positioned toggle. */
      position: sticky;
    }

    :global(:root[data-tsg-sidebar='collapsed']) :global(.container-wrapper-main) {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    :global(:root[data-tsg-sidebar='collapsed']) .tsg-sidebar {
      visibility: hidden;
    }

    /* Use some of the freed space for a wider article column. */
    :global(:root[data-tsg-sidebar='collapsed']) :global(.container-main .main) {
      max-width: 48rem;
    }

    /* Collapsed: the toggle sits on the content inset, under the logo. */
    :global(:root[data-tsg-sidebar='collapsed']) .tsg-sidebar-toggle {
      right: auto;
      left: 0;
    }

    :global(:root[data-tsg-sidebar='collapsed']) .tsg-sidebar-toggle :global(svg) {
      transform: rotate(180deg);
    }
  }
</style>
