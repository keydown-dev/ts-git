---
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<div class="sidebar-banner">
  <div class="alpha-banner-card">
    <strong>Alpha release</strong>
    <p>
      TS-Git covers the local Git workflow plus clone, fetch, push and pull
      over smart HTTP. APIs may still change.
    </p>
    <a href="/roadmap/">Roadmap and limitations →</a>
  </div>
</div>

<Default {...Astro.props}>
  <slot />
</Default>

<style>
  .sidebar-banner {
    padding: 0 0.5em;
    margin-bottom: 0.5rem;
  }

  .alpha-banner-card {
    background: var(--sl-color-accent-low);
    border: 1px solid hsla(211, 60%, 55%, 0.45);
    border-radius: 0.5rem;
    padding: 0.75rem;
    font-size: var(--sl-text-xs);
  }

  .alpha-banner-card strong {
    color: var(--sl-color-accent-high);
    display: block;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--sl-text-2xs);
  }

  .alpha-banner-card p {
    color: var(--sl-color-text);
    margin: 0 0 0.5rem 0;
    line-height: 1.45;
  }

  .alpha-banner-card a {
    color: var(--sl-color-accent-high);
    text-decoration: none;
    font-weight: 600;
  }

  .alpha-banner-card a:hover {
    text-decoration: underline;
  }
</style>
